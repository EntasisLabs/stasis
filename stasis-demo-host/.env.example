# Required. Held only in this process — never sent to the browser.
OPENAI_API_KEY=sk-...

# OpenAI-compatible /v1 root. Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Loopback proxy (shared only via urspace Site::serve).
# PROXY_BIND=127.0.0.1:8787

# Public mint + health (or bind this behind a tunnel).
# MINT_BIND=0.0.0.0:8788

# Per-browser-identity daily caps (UTC date). Restart resets in-memory counts.
# DAILY_COMPLETIONS=5
# DAILY_TOKENS=8000

# Comma-separated allowlist. Default: gpt-4o-mini
# ALLOWED_MODELS=gpt-4o-mini

# Subject-bound mint (matches urspace MintOptions defaults).
# MINT_TTL_SECS=30
# MINT_MAX_SESSIONS=1

# Mint rate limits (in-memory sliding window).
# MINT_PER_IP=10
# MINT_PER_SUBJECT=5
# MINT_WINDOW_SECS=600

# Honor X-Forwarded-For on the mint listener (only behind a trusted proxy).
# TRUST_PROXY=0

# CORS for POST /bootstrap from the public site. * or comma-separated origins.
# CORS_ORIGIN=*

# Optional origin signed into minted tokens (urspace ShareOptions). Default: https://urspace.online
# URSPACE_BOOTSTRAP_ORIGIN=https://urspace.online

# RUST_LOG=stasis_demo_host=info,urspace=warn
